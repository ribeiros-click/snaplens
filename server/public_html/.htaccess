Options -Indexes
RewriteEngine On

# Protege configuração, dados e código auxiliar
<FilesMatch "^(config(\.example)?\.php|lib\.php|_inc\.php)$|\.sqlite(-wal|-shm)?$">
    Require all denied
</FilesMatch>
RewriteRule ^_data/ - [F,L]

# Rotas
RedirectMatch 301 ^/download/SnapLens\.dmg$ https://github.com/ribeiros-click/snaplens/releases/latest/download/SnapLens.dmg
RewriteRule ^s/([A-Za-z0-9]{10})/?$ view.php?id=$1 [L,QSA]
RewriteRule ^i/([A-Za-z0-9]{10})/?$ image.php?id=$1 [L,QSA]
RewriteRule ^api/(upload|delete)/?$ api/$1.php [L,QSA]
RewriteRule ^(admin|token|contato)/?$ $1.php [L,QSA]

# Uploads
php_value upload_max_filesize 32M
php_value post_max_size 34M

# Cabeçalhos
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "no-referrer"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Downloads: tipo correto e força "salvar como" em vez de exibir no navegador
AddType application/x-apple-diskimage .dmg
AddType application/octet-stream .pkg .zip
<FilesMatch "\.(dmg|pkg|zip)$">
    Header set Content-Disposition "attachment"
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>
